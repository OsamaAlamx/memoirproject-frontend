# Copy this file to .env.local and adjust as needed.
# All variables are validated at startup by src/lib/config/env.ts.

# Base URL of the FastAPI backend, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. How long a single API request may take, in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Supabase project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Storage bucket for memoir media (must match the backend's SUPABASE_BUCKET_NAME).
NEXT_PUBLIC_SUPABASE_BUCKET=memoir-media
