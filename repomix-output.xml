          {/* Main Top Sheet */}
          <div
            className="relative w-full rounded-[2px_12px_4px_16px] border border-memory-border bg-white shadow-[0_15px_40px_rgba(56,28,36,0.1)] transition-transform duration-500 group-hover:rotate-0 overflow-hidden"
            style={{
